# Toss Securities Open API credentials
# Issue these in Toss Securities WTS: Settings > Open API.
TOSS_CLIENT_ID=your_toss_client_id
TOSS_CLIENT_SECRET=your_toss_client_secret

# Toss Securities REST API base URL. Keep the official production URL.
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# Local PostgreSQL database used by this project.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/trading

# Safety switch. Keep false throughout v0.1: no live-order feature is enabled.
LIVE_TRADING=false

